# Copy to .env and adjust. All optional.
VOSK_MODEL_PATH=models/vosk-model-small-en-in-0.4
STT_GRAMMAR=1               # restrict the recognizer to catalog + number words
WAKE_WORD=hello
WAKE_FUZZ=0.78              # 1.0 = exact spelling only, lower = more forgiving
COMMAND_WINDOW_SEC=15       # how long to keep listening after the wake word
COMMAND_SETTLE_SEC=1.6 
VOICE_INPUT_DEVICE=         # sounddevice index; blank = system default
VOICE_AUTOSTART=0           # 1 = open the SERVER's own mic on boot (rarely wanted)
PENDING_ALERT_MIN=7         # flag a sale still unpaid after this many minutes
LOG_LEVEL=INFO
